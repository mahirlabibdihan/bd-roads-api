# Express server and frontend CORS
NODE_ENV=development
HOST=127.0.0.1
PORT=5002
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Road-network extraction limits (GET /api/roads)
# ROADS_MAX_BBOX_DEGREES caps how much of the country one request may pull at once.
# 0.5 degrees is roughly 55 km, comfortably larger than any single beat or post office boundary.
ROADS_MAX_BBOX_DEGREES=0.5
ROADS_DEFAULT_LIMIT=2000
ROADS_MAX_LIMIT=10000

# Snapping limits (GET /api/snap, POST /api/snap/path)
SNAP_DEFAULT_RADIUS_METERS=50
SNAP_MAX_RADIUS_METERS=500
SNAP_MAX_POINTS=2000

# OSRM map-matching service (POST /api/match)
OSRM_BASE_URL=http://127.0.0.1:5010
OSRM_PROFILE=foot
OSRM_LISTEN_IP=127.0.0.1
OSRM_LISTEN_PORT=5010
OSRM_MAX_MATCHING_SIZE=1000
OSRM_REQUEST_TIMEOUT_MS=10000
OSRM_HOME=/srv/osrm
OSRM_VERSION=v5.27.1

# Database request timeout shared by the API pools
DB_REQUEST_TIMEOUT_MS=5000

# Redis connection and protected background-update API
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CONNECT_TIMEOUT_MS=1000
ROAD_INDEX_ADMIN_TOKEN=replace-with-a-long-random-token
ROAD_INDEX_UPDATE_ENABLED=true
ROAD_INDEX_UPDATE_TIMEOUT_SECONDS=7200
# OSRM cannot be updated incrementally -- refreshing it means re-downloading the PBF and
# re-running the full extract/partition/customize pipeline. Leave this false to keep routine
# updates fast; PostGIS roads (and therefore /api/snap) still update every time.
ROAD_INDEX_OSRM_REBUILD_ENABLED=false

# Read-only PostgreSQL connection used by the API
DB_USER=roads_api
DB_HOST=127.0.0.1
DB_PASS=replace-with-a-strong-password
DB_DB=roads
DB_PORT=5432
DB_SSL=false
DB_PGPASSFILE=/srv/road-network/.pgpass

# PostgreSQL administrator and import-role credentials used during initial setup
DB_ADMIN_USER=postgres
DB_ADMIN_PASS=
DB_ADMIN_DB=postgres
ROADS_DB_USER=roads_import
ROADS_DB_PASS=replace-with-a-strong-password
# Replication credentials for the import role (separate from the read-only DB_PGPASSFILE)
ROADS_PGPASSFILE=/srv/road-network/import.pgpass

# Source data, replication feed, and osm2pgsql import tuning
ROADS_HOME=/srv/road-network
OSM_PBF_URL=https://download.geofabrik.de/asia/bangladesh-latest.osm.pbf
OSM_REPLICATION_URL=https://download.geofabrik.de/asia/bangladesh-updates
# Where the downloaded PBF is kept. Compose overrides this to a shared volume so the PostGIS
# import and the OSRM graph build use one download instead of two.
OSM_PBF_DIR=/srv/road-network/data
OSM2PGSQL_CACHE_MB=2000
OSM2PGSQL_PROCESSES=2
OSM2PGSQL_BIN=osm2pgsql
OSM2PGSQL_REPLICATION_BIN=osm2pgsql-replication
